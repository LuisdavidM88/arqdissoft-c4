#!/bin/sh
# Maven Wrapper simplificado (macOS / Linux): descarga Maven la primera vez y lo usa.
# Uso:  ./mvnw spring-boot:run   |   ./mvnw test
set -e
MVNW_VERSION=3.9.9
MVNW_DIR="$HOME/.m2/wrapper/dists"
MVNW_HOME="$MVNW_DIR/apache-maven-$MVNW_VERSION"
MVNW_URL="https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/$MVNW_VERSION/apache-maven-$MVNW_VERSION-bin.zip"

if [ ! -x "$MVNW_HOME/bin/mvn" ]; then
  echo "[mvnw] Descargando Apache Maven $MVNW_VERSION (solo la primera vez)..."
  mkdir -p "$MVNW_DIR"
  ZIP="$(mktemp)"
  curl -fsSL "$MVNW_URL" -o "$ZIP"
  unzip -q -o "$ZIP" -d "$MVNW_DIR"
  rm -f "$ZIP"
fi

exec "$MVNW_HOME/bin/mvn" "$@"
